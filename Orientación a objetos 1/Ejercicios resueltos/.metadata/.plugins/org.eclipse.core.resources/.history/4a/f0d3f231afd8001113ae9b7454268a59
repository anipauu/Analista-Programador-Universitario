package ar.edu.unlp.info.oo1.Ejercicio30;

import java.time.LocalDate;

public class Interurbano extends Envio {
	private double distancia;

	public Interurbano(LocalDate fechaDespacho, String origen, String destino, double precio, double distancia) {
		super(fechaDespacho, origen, destino, precio);
		this.distancia = distancia;
	}
	
	public double calcularTarifa() {
		if (this.distancia < 100) return 20; 
		if (this.distancia >= 100 && this.distancia <= 500) return 25; 
		return 30; 
	}

	public double costo() {
		return this.calcularTarifa() * this.distancia: 
	}
	
	
	
}
