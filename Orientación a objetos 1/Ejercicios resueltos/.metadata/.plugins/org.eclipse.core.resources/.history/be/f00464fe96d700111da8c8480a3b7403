package ar.edu.unlp.info.oo1.ServiciosTuristicos;

import java.time.LocalDate;

public class Estadia extends Servicio{
	private String destino; 
	private int cantidadPersonas; 
	private double costoPorDia; 
	
	public Estadia(LocalDate fechaInicio, LocalDate fechaFin, double costoPorDia, String destino, int cantidadPersonas) {
		super(fechaInicio, fechaFin);
		this.costoPorDia = costoPorDia; 
		this.destino = destino; 
		this.cantidadPersonas = cantidadPersonas; 
	}
	
	public double calcularCostoPorDia() {
		return this.calcularCosto() * cantidadPersonas; 
	}
	
}
