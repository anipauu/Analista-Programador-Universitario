package ar.edu.unlp.info.oo1.GreenHOOme;

import static org.junit.jupiter.api.Assertions.*;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

class OrdenCompraTest {

    private Producto calefon;
    
    @BeforeEach
    void setUp() {
        calefon = new Producto("Calefón solar", "Ecológico", 50000, false);
    }
    
    @Test
    void testCostoTotalSinDescuento() {
    	OrdenCompra ordenCompra = new OrdenCompra("Calle 8", 5000.0);
    	for (int i = 0; i < 4; i++ ) {
    		ordenCompra.agregarProducto(calefon);
    	}
    	assertEquals(205000, ordenCompra.calcularCosto());
    }
    
    @Test
    void testCostoTotalConDescuento() {
    	OrdenCompra ordenCompra = new OrdenCompra("Calle 8", 5000.0);
    	for (int i = 0; i <6; i ++) {
    		ordenCompra.agregarProducto(calefon);
    	}
    	assertEquals(229500, ordenCompra.calcularCosto()); 
    }
    
}
