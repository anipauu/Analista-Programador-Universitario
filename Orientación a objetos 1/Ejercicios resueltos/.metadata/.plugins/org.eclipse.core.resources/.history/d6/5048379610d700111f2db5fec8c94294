package ar.edu.unlp.info.oo1.GreenHOOme;

public class OrdenCompra extends Orden {
	private double precioEnvio; 
	
	public OrdenCompra(String domicilio, double precioEnvio) {
		super(domicilio);
		this.precioEnvio = precioEnvio; 
	}
	
	@Override
	public double calcularCosto() {
		double costoTotal =  this.productos.stream()
				.mapToDouble(producto -> producto.getCosto())
				.sum() + this.precioEnvio;
		return (this.productos.size() >= 5 ? costoTotal * 0.9 : costoTotal); 
	}
	
}
